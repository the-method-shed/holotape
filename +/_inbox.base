filters:
  and:
    - file.folder == "+"
    - file.ext == "md"
    - file.path != "+/_inbox.md"
formulas:
  days_in_inbox: '(now() - file.ctime).days'
properties:
  formula.days_in_inbox:
    displayName: Days in inbox
views:
  - type: table
    name: Recent inbox items
    order:
      - file.name
      - formula.days_in_inbox
      - file.tags
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 10
    columnSize:
      file.ctime: 180
