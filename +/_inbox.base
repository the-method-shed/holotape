filters:
  and:
    - file.folder == "+"
    - file.ext == "md"
    - file.path != "+/_inbox.md"
views:
  - type: table
    name: Recent inbox items
    order:
      - file.name
      - author
      - file.tags
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
      - property: file.ctime
        direction: DESC
    limit: 10
    columnSize:
      file.ctime: 180
