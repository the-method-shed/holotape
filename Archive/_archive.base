filters:
  and:
    - file.folder == "Archive"
    - file.ext == "md"
    - file.path != "Archive/_archive.md"
views:
  - type: table
    name: Recent archive pages
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 10
    columnSize:
      file.name: 415
