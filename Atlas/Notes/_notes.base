filters:
  and:
    - file.folder == "Atlas/Notes"
    - file.ext == "md"
    - file.path != "Atlas/Notes/_notes.md"
views:
  - type: table
    name: Recent notes
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 20
    columnSize:
      file.name: 468
