filters:
  and:
    - file.folder == "Projects"
    - file.ext == "md"
    - file.basename.startsWith("Project - ")
views:
  - type: table
    name: All projects
    order:
      - file.name
      - stage
      - priority
      - leads
    columnSize:
      file.name: 129
      note.stage: 132
      note.priority: 151
